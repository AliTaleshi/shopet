# Copy to .env and adjust
POSTGRES_DB=shopet
POSTGRES_USER=shopet
POSTGRES_PASSWORD=shopet_secret

# At least 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars

# This mobile number becomes admin on startup
ADMIN_PHONE=09120000000

# Return the OTP code in the API response (demo mode, no real SMS provider)
OTP_EXPOSE_CODE=true

# Insert demo categories/products/coupons on first start
SEED_DEMO_DATA=true

WEB_PORT=8088
API_PORT=8089
