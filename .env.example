# Copy to .env and adjust
POSTGRES_DB=shopet
POSTGRES_USER=shopet
POSTGRES_PASSWORD=shopet_secret

# Token signing key, at least 32 characters (e.g. `openssl rand -base64 48`).
# Leave empty to use a random key per start; users then have to log in again after every restart.
JWT_SECRET=

# This mobile number becomes admin on startup
ADMIN_PHONE=09120000000

# Demo mode: return the OTP code in the API response (no real SMS provider).
# Anyone can then log in as any number, including the admin. Set to false for real users.
OTP_EXPOSE_CODE=true

# Insert demo categories/products/coupons on first start
SEED_DEMO_DATA=true

WEB_PORT=8088
API_PORT=8089
